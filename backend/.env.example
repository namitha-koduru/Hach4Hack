# TeamForge Backend Configuration

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamforge?schema=public"

# Test Database Connection String
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamforge_test?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS & Client
CLIENT_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

